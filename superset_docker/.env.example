# Plantilla: copia este archivo como .env (en esta misma carpeta) y completa tus valores.
# docker compose lee .env automáticamente. .env está en .gitignore.
POSTGRES_USER=project_nero
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=superset
# Genera una clave larga y aleatoria, por ejemplo: openssl rand -base64 42
SUPERSET_SECRET_KEY=cambia_esta_clave_secreta
SUPERSET_ADMIN_PASSWORD=cambia_esta_contraseña
